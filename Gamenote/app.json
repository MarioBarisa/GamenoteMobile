{
  "expo": {
    "name": "Gamenote",
    "slug": "Gamenote",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "gamenote",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "eu.gamenote.ios",
      "infoPlist": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPICategoryDiskSpace": "Used to display available storage info"
          },
          {
            "NSPrivacyAccessedAPICategoryFileTimestamp": "Used for game save timestamps"
          },
          {
            "NSPrivacyAccessedAPICategoryUserDefaults": "Used to store user preferences (AsyncStorage)"
          },
          {
            "NSPrivacyAccessedAPICategorySystemBootTime": "Used for session timeouts"
          }
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.gamenote.ios"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/gamenote/icons/GamenoteIcon-iOS-Default-1024x1024@1x.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-web-browser",
      "@react-native-community/datetimepicker",
      "expo-font",
      "./plugins/withAlternateAppIcons"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
